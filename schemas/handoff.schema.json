{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-agent handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "resume_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNING",
        "APPROVED",
        "EXECUTING",
        "WAITING",
        "BLOCKED",
        "FAILED",
        "COMPLETED"
      ]
    },
    "approved_scope_reference": {
      "type": "string",
      "minLength": 1
    },
    "known_execution_ids": {
      "type": "array"
    },
    "evidence_received": {
      "type": "array"
    },
    "evidence_missing": {
      "type": "array"
    },
    "expected_outputs": {
      "type": "array"
    },
    "next_human_step": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "resume_id",
    "status",
    "approved_scope_reference",
    "known_execution_ids",
    "evidence_received",
    "evidence_missing",
    "expected_outputs",
    "next_human_step",
    "updated_at"
  ]
}
