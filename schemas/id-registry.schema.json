{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific ID registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "W",
              "A",
              "S",
              "T",
              "M"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "by",
              "reference",
              "date"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "active",
              "retired"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "history": {
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "parent",
          "title",
          "path",
          "links",
          "approval",
          "state",
          "sha256",
          "history"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "records"
  ]
}
