{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed v0.5 baseline",
  "description": "Structural definition only; framework semantic and filesystem validation is also required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "framework_version",
    "distribution",
    "observed_on",
    "source_revision",
    "content_review",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "legacy_baseline"
    },
    "framework_version": {
      "const": "0.5"
    },
    "distribution": {
      "const": "Starter v3"
    },
    "observed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_revision": {
      "type": "null"
    },
    "content_review": {
      "const": "reviewed_generic"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          }
        }
      }
    }
  }
}
