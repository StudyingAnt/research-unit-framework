{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional execution Run",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "status": {
      "enum": [
        "PLANNING",
        "APPROVED",
        "EXECUTING",
        "WAITING",
        "BLOCKED",
        "FAILED",
        "COMPLETED"
      ]
    },
    "performer": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "protocol",
              "sample",
              "acquisition",
              "computation",
              "environment",
              "input",
              "output",
              "interpretation",
              "approval"
            ]
          },
          "verification": {
            "enum": [
              "planned",
              "source_default",
              "reconstructed",
              "verified_effective",
              "unknown"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "producing_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "available_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "dirty_source_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "required": [
          "category",
          "verification",
          "reference",
          "description",
          "producing_revision",
          "available_revision",
          "dirty_source_hashes"
        ]
      }
    },
    "outputs": {
      "type": "array"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "array"
        },
        "received": {
          "type": "array"
        },
        "checks": {
          "type": "array"
        },
        "missing": {
          "type": "array"
        }
      },
      "required": [
        "expected",
        "received",
        "checks",
        "missing"
      ]
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "run_id",
    "status",
    "performer",
    "started_at",
    "completed_at",
    "command",
    "external_id",
    "provenance",
    "outputs",
    "validation"
  ]
}
